# =============================================================================
# GitHub Codespaces Development Configuration
# =============================================================================
# This file provides safe defaults for testing and development in Codespaces.
# Copy to .env or use the post-start.sh script (runs automatically).
#
# For GitHub Codespaces secrets setup:
# 1. Go to your repository → Settings → Secrets and variables → Codespaces
# 2. Add secret: ADMIN_TOKEN (generate with: openssl rand -hex 32)
# 3. Add secret: PRIVATE_KEY (optional, test wallets only!)
#
# SECURITY: Never commit real secrets. This is for DEVELOPMENT/TESTING only.
# =============================================================================

# Polymarket API Configuration
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Market Feed Configuration
# Comma-separated list of token IDs to monitor
# Example: TOKEN_IDS=0x123abc,0x456def
TOKEN_IDS=

# Logging (debug level for development)
LOG_LEVEL=debug

# Trading gates (SAFETY: default to paper mode)
LIVE_TRADING=false
COMPLIANCE_ACCEPTED=false

# Trading credentials (optional - only for live trading testing)
# CRITICAL: Use test wallets only! Set via GitHub Codespaces Secrets.
# Do NOT hardcode real private keys here or anywhere in the repository.
# PRIVATE_KEY=YOUR_TEST_WALLET_PRIVATE_KEY_FROM_GITHUB_SECRETS
CHAIN_ID=137

# Server
PORT=3000

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
RETRY_TOTAL_TIMEOUT=300000

# Paper Trading Configuration (realistic simulation)
PAPER_TRADING_SLIPPAGE=0.01
PAPER_TRADING_MAX_SLIPPAGE=0.05
PAPER_TRADING_FEE_RATE=0.002
PAPER_TRADING_PARTIAL_FILL_RATE=0.0
PAPER_TRADING_MIN_FILL_RATIO=0.1
PAPER_TRADING_MAX_FILL_RATIO=0.9

# Risk Management Configuration
RISK_MAX_EXPOSURE_PER_MARKET=1000
RISK_MAX_OPEN_ORDERS=50
RISK_MAX_DRAWDOWN=0.20
RISK_ERROR_RATE_THRESHOLD=0.10
RISK_ERROR_RATE_WINDOW=100

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# =============================================================================
# Admin Authentication - SET VIA GITHUB CODESPACES SECRETS
# =============================================================================
# REQUIRED for sensitive endpoints (kill switch, order management, etc.)
#
# How to set up:
# 1. Generate token: openssl rand -hex 32
# 2. In GitHub: Repository → Settings → Secrets and variables → Codespaces
# 3. Add new secret: Name=ADMIN_TOKEN, Value=<your generated token>
# 4. Restart Codespace to pick up the secret
#
# For testing without admin token, endpoints will return 401 Unauthorized.
# This is SAFE for development - you can still test read-only endpoints.
ADMIN_TOKEN=USE_GITHUB_CODESPACES_SECRET

# CORS Configuration (allow all origins for Codespaces)
# SAFE: Codespaces URLs are unique and ephemeral
# Production MUST use specific origins
ALLOWED_ORIGINS=*

# =============================================================================
# Reconciliation Configuration
# =============================================================================
RECONCILIATION_INTERVAL_SECONDS=300

# =============================================================================
# Rate Limiting Configuration (relaxed for development)
# =============================================================================
# Higher limits for testing to avoid throttling during development
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_TRUST_PROXY=false

# =============================================================================
# Alerting Configuration (optional - for testing alerts)
# =============================================================================
# To test Telegram alerts:
# 1. Create bot via @BotFather
# 2. Get chat ID from: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Set via GitHub Codespaces Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

ALERT_ERROR_RATE_THRESHOLD=5
ALERT_CIRCUIT_BREAKER_TRIPS=1

# =============================================================================
# Learning System Configuration
# =============================================================================
# Database paths (relative to project root)
EVENT_STORE_PATH=./data/events.db
SIGNAL_CATALOG_PATH=./data/signals.db
BACKTEST_ENGINE_PATH=./data/backtests.db
PROMOTION_WORKFLOW_PATH=./data/promotions.db

# =============================================================================
# SECRET MANAGEMENT
# =============================================================================
# Default to environment variables for Codespaces
# Advanced options (encrypted, AWS, Vault, Azure) require additional setup
SECRET_SOURCE=env
