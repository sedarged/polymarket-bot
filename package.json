{
  "name": "polymarket-bot",
  "version": "1.30.0",
  "description": "Polymarket read-only starter - fetch markets and orderbooks",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "dev": "npm run --workspace @polymarket/backend dev",
    "markets": "npm run --workspace @polymarket/backend markets",
    "book": "npm run --workspace @polymarket/backend book",
    "test": "npm run --workspace @polymarket/backend test",
    "test:watch": "npm run --workspace @polymarket/backend test:watch",
    "test:coverage": "npm run --workspace @polymarket/backend test:coverage",
    "lint": "eslint --ext .ts,.tsx apps/backend/src apps/backend/tests packages/shared/src scripts docs/examples"
  },
  "keywords": [
    "polymarket",
    "orderbook",
    "markets",
    "typescript"
  ],
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2"
  }
}
