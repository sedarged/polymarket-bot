{
  "name": "polymarket-bot",
  "version": "1.27.1",
  "description": "Polymarket read-only starter - fetch markets and orderbooks",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "backend:dev": "npm run --workspace @polymarket/backend dev",
    "markets": "npm run --workspace @polymarket/backend markets",
    "book": "npm run --workspace @polymarket/backend book",
    "test": "npm run --workspace @polymarket/backend test",
    "test:watch": "npm run --workspace @polymarket/backend test:watch",
    "test:coverage": "npm run --workspace @polymarket/backend test:coverage"
  },
  "keywords": [
    "polymarket",
    "orderbook",
    "markets",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  }
}
