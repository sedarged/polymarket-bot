{
  "dashboard": {
    "title": "Polymarket Trading Bot",
    "tags": ["polymarket", "trading", "prometheus"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Order Placement Rate",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(polymarket_orders_total[5m])",
            "legendFormat": "{{side}} - {{result}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "ops", "label": "Orders/sec" },
          { "format": "short" }
        ]
      },
      {
        "id": 2,
        "title": "Order Latency (p95)",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(polymarket_order_latency_seconds_bucket[5m]))",
            "legendFormat": "{{side}} - p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, rate(polymarket_order_latency_seconds_bucket[5m]))",
            "legendFormat": "{{side}} - p99",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "s", "label": "Latency" },
          { "format": "short" }
        ]
      },
      {
        "id": 3,
        "title": "WebSocket Connection State",
        "type": "stat",
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "polymarket_websocket_state{feed_type=\"market\"}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "value": 0, "text": "DISCONNECTED" },
              { "value": 1, "text": "CONNECTING" },
              { "value": 2, "text": "CONNECTED" },
              { "value": 3, "text": "RECONNECTING" },
              { "value": 4, "text": "CLOSED" }
            ],
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "yellow" },
                { "value": 2, "color": "green" },
                { "value": 3, "color": "orange" },
                { "value": 4, "color": "dark-red" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Circuit Breaker State",
        "type": "stat",
        "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "max(polymarket_circuit_breaker_state)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "value": 0, "text": "CLOSED (OK)" },
              { "value": 1, "text": "OPEN (TRIPPED)" },
              { "value": 2, "text": "HALF_OPEN (TESTING)" }
            ],
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "red" },
                { "value": 2, "color": "yellow" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Open Orders",
        "type": "stat",
        "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(polymarket_open_orders)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Cached Orderbooks",
        "type": "stat",
        "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "polymarket_cached_orderbooks",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 7,
        "title": "WebSocket Reconnections",
        "type": "graph",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(polymarket_websocket_reconnects_total[5m])",
            "legendFormat": "{{feed_type}} - {{result}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "ops", "label": "Reconnects/sec" },
          { "format": "short" }
        ]
      },
      {
        "id": 8,
        "title": "Circuit Breaker Failures",
        "type": "graph",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(polymarket_circuit_breaker_failures_total[5m])",
            "legendFormat": "{{breaker_name}} - failures",
            "refId": "A"
          },
          {
            "expr": "rate(polymarket_circuit_breaker_trips_total[5m])",
            "legendFormat": "{{breaker_name}} - trips",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "ops", "label": "Events/sec" },
          { "format": "short" }
        ]
      },
      {
        "id": 9,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024",
            "legendFormat": "RSS (MB)",
            "refId": "A"
          },
          {
            "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
            "legendFormat": "Heap Used (MB)",
            "refId": "B"
          },
          {
            "expr": "nodejs_heap_size_total_bytes / 1024 / 1024",
            "legendFormat": "Heap Total (MB)",
            "refId": "C"
          }
        ],
        "yaxes": [
          { "format": "decmbytes", "label": "Memory (MB)" },
          { "format": "short" }
        ]
      },
      {
        "id": 10,
        "title": "Process Uptime",
        "type": "stat",
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "process_uptime_seconds",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      }
    ]
  }
}
