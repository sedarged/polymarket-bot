{
  "name": "@polymarket/backend",
  "version": "1.0.0",
  "description": "Polymarket read-only starter - fetch markets and orderbooks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "polymarket": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "markets": "tsx src/index.ts markets",
    "book": "tsx src/index.ts book",
    "kill": "tsx src/index.ts kill",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:backtest": "vitest run tests/backtest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.2.1",
    "@polymarket/shared": "file:../../packages/shared",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.4",
    "ethers": "^5.7.2",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
