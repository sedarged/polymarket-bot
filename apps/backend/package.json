{
  "name": "@polymarket/backend",
  "version": "1.0.0",
  "description": "Polymarket read-only starter - fetch markets and orderbooks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "polymarket": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "markets": "tsx src/index.ts markets",
    "book": "tsx src/index.ts book",
    "kill": "tsx src/index.ts kill",
    "rates": "tsx src/index.ts rates",
    "backup": "tsx src/index.ts backup",
    "backup:list": "tsx src/index.ts backup --list",
    "backtest": "tsx src/index.ts backtest",
    "example:execution": "tsx examples/execution-service-example.ts",
    "example:validate": "tsx examples/validate-strategy-example.ts",
    "example:hotreload": "tsx examples/strategyHotReload.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:backtest": "vitest run tests/backtest",
    "test:chaos": "vitest run --config vitest.chaos.config.ts --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation-test": "stryker run",
    "bench": "vitest bench",
    "bench:verbose": "vitest bench --reporter=verbose"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.999.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@ethersproject/wallet": "^5.8.0",
    "@polymarket/clob-client": "^5.2.4",
    "@polymarket/shared": "file:../../packages/shared",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "node-vault": "^0.11.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
