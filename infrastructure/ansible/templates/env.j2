# Environment Configuration for Polymarket Bot
# Environment: {{ environment }}
# Generated by Ansible

# API Configuration
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Trading Gates
# CRITICAL: These must be explicitly set to true by the operator
# Never auto-enable live trading, even in production environments
LIVE_TRADING=false
COMPLIANCE_ACCEPTED=false

# Server Configuration
PORT=3000
METRICS_PORT=9090
LOG_LEVEL={{ 'info' if environment == 'production' else 'debug' }}

# Blockchain
CHAIN_ID=137

# Secret Management
SECRET_SOURCE=env
PRIVATE_KEY={{ vault_private_key | default('') }}
ADMIN_TOKEN={{ vault_admin_token | default('') }}

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
RETRY_TOTAL_TIMEOUT=300000

# Paper Trading
PAPER_TRADING_SLIPPAGE=0.01
PAPER_TRADING_MAX_SLIPPAGE=0.05
PAPER_TRADING_FEE_RATE=0.002
PAPER_TRADING_PARTIAL_FILL_RATE=0.0
PAPER_TRADING_MIN_FILL_RATIO=0.1
PAPER_TRADING_MAX_FILL_RATIO=0.9

# Risk Management
RISK_MAX_EXPOSURE_PER_MARKET={{ '1000' if environment == 'production' else '100' }}
RISK_MAX_OPEN_ORDERS={{ '50' if environment == 'production' else '10' }}
RISK_MAX_DRAWDOWN=0.20
RISK_ERROR_RATE_THRESHOLD=0.10
RISK_ERROR_RATE_WINDOW=100

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Reconciliation
RECONCILIATION_INTERVAL_SECONDS=300

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_TRUST_PROXY=false

# Alerting
TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token | default('') }}
TELEGRAM_CHAT_ID={{ vault_telegram_chat_id | default('') }}
ALERT_ERROR_RATE_THRESHOLD=5
ALERT_CIRCUIT_BREAKER_TRIPS=1

# Learning System Database Paths
EVENT_STORE_PATH={{ data_dir }}/{{ environment }}/events.db
SIGNAL_CATALOG_PATH={{ data_dir }}/{{ environment }}/signals.db
BACKTEST_ENGINE_PATH={{ data_dir }}/{{ environment }}/backtests.db
PROMOTION_WORKFLOW_PATH={{ data_dir }}/{{ environment }}/promotions.db
