# Kubernetes Secret for Polymarket Bot - Staging Environment
# Addresses GAP-042: Staging Environment
#
# IMPORTANT: This is an example file. DO NOT commit actual secrets!
# Create the actual secret using:
#   kubectl create secret generic polymarket-bot-staging-secrets \
#     --from-literal=PRIVATE_KEY=your_staging_private_key \
#     --from-literal=ADMIN_TOKEN=your_staging_admin_token \
#     --namespace=polymarket-staging
#
# Or apply this file after base64-encoding the values:
#   echo -n "your_value" | base64

apiVersion: v1
kind: Secret
metadata:
  name: polymarket-bot-staging-secrets
  namespace: polymarket-staging
  labels:
    app: polymarket-bot
    environment: staging
type: Opaque
data:
  # Base64-encoded private key (REQUIRED if using wallet features)
  # Use a dedicated staging wallet with minimal test funds
  PRIVATE_KEY: ""  # base64-encoded value
  
  # Base64-encoded admin token for API authentication
  # Generate with: openssl rand -hex 32 | base64
  ADMIN_TOKEN: ""  # base64-encoded value
  
  # Optional: Telegram bot configuration for staging alerts
  TELEGRAM_BOT_TOKEN: ""  # base64-encoded value
  TELEGRAM_CHAT_ID: ""    # base64-encoded value
  
  # Optional: Encrypted private key configuration
  ENCRYPTION_KEY: ""         # base64-encoded value
  ENCRYPTED_PRIVATE_KEY: ""  # base64-encoded value
