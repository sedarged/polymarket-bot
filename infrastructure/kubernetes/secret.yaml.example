# Kubernetes Secret for sensitive configuration
# IMPORTANT: This is an example. DO NOT commit actual secrets.
# Create actual secret using: kubectl create secret generic polymarket-bot-secrets --from-env-file=.env
apiVersion: v1
kind: Secret
metadata:
  name: polymarket-bot-secrets
  namespace: polymarket-bot
type: Opaque
stringData:
  # Trading Gates (default to safe mode)
  LIVE_TRADING: "false"
  COMPLIANCE_ACCEPTED: "false"
  
  # Credentials (REPLACE WITH ACTUAL VALUES)
  PRIVATE_KEY: "0xYOUR_PRIVATE_KEY_HERE"
  ADMIN_TOKEN: "YOUR_ADMIN_TOKEN_HERE"
  
  # Telegram Alerting (optional)
  TELEGRAM_BOT_TOKEN: ""
  TELEGRAM_CHAT_ID: ""
