# Polymarket API Configuration
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Market Feed Configuration
# Comma-separated list of token IDs to monitor
# Example: TOKEN_IDS=0x123abc,0x456def
TOKEN_IDS=

# Logging
LOG_LEVEL=info

# Trading gates (default to paper mode)
LIVE_TRADING=false
COMPLIANCE_ACCEPTED=false

# Trading credentials (optional - only required for live trading)
# CRITICAL SECURITY: Private key storage addresses Audit Finding A-001
# 
# Method 1 (Default - Least Secure): Direct environment variable
# Only use for local development. Set SECRET_SOURCE=env (default)
# PRIVATE_KEY=your_wallet_private_key_here
#
# Method 2 (Improved): Encrypted local storage
# Encrypt your private key and store it here. Requires ENCRYPTION_KEY passphrase.
# To encrypt: Use the encryption tool (see docs/security.md)
# SECRET_SOURCE=encrypted
# ENCRYPTION_KEY=your_strong_passphrase_here
# ENCRYPTED_PRIVATE_KEY=salt:iv:authTag:encryptedData
#
# Method 3 (Production - AWS Secrets Manager):
# SECRET_SOURCE=aws
# AWS_SECRET_NAME=polymarket-bot/private-key
# AWS_REGION=us-east-1
#
# Method 4 (Production - HashiCorp Vault):
# SECRET_SOURCE=vault
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=your_vault_token
# VAULT_PATH=secret/data/polymarket
#
# Method 5 (Production - Azure Key Vault):
# SECRET_SOURCE=azure
# AZURE_KEY_VAULT_NAME=my-keyvault
# AZURE_SECRET_NAME=polymarket-private-key
#
CHAIN_ID=137

# Server
PORT=3000

# Retry Configuration (optional)
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Paper Trading Configuration
# Base slippage percentage (applied to small orders)
PAPER_TRADING_SLIPPAGE=0.01
# Maximum slippage percentage (applied when order size equals available liquidity)
PAPER_TRADING_MAX_SLIPPAGE=0.05
PAPER_TRADING_FEE_RATE=0.002

# Partial Fill Simulation (for realistic CLOB behavior)
# Base probability of partial fill (0-1), scaled by order size relative to liquidity
# 0.0 = always full fill (default), 1.0 = always partial fill
PAPER_TRADING_PARTIAL_FILL_RATE=0.0
# When partial fills occur, fill between min and max ratio of order size
PAPER_TRADING_MIN_FILL_RATIO=0.1
PAPER_TRADING_MAX_FILL_RATIO=0.9

# Risk Management Configuration
RISK_MAX_EXPOSURE_PER_MARKET=1000
RISK_MAX_OPEN_ORDERS=50
RISK_MAX_DRAWDOWN=0.20
RISK_ERROR_RATE_THRESHOLD=0.10
RISK_ERROR_RATE_WINDOW=100

# ========================================
# Admin Authentication (Audit Finding A-004)
# ========================================
# Admin token for securing sensitive API endpoints
# REQUIRED for production and live trading modes
# Protects: kill switch, order management, trading status, config changes
#
# Generate a secure token:
#   openssl rand -hex 32
#
# All sensitive endpoints require this token in the Authorization header:
#   Authorization: Bearer YOUR_ADMIN_TOKEN
#   or simply: Authorization: YOUR_ADMIN_TOKEN
#
# Leave empty for development/testing ONLY (endpoints will be disabled)
ADMIN_TOKEN=change_me_to_a_strong_random_admin_token

# CORS Configuration
# Comma-separated list of allowed origins for CORS (Cross-Origin Resource Sharing)
# CRITICAL: Use '*' ONLY for local development. Production MUST use specific origins.
# Examples:
#   Development: ALLOWED_ORIGINS=*
#   Single origin: ALLOWED_ORIGINS=https://app.example.com
#   Multiple origins: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
