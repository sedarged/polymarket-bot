# Polymarket API Configuration
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Market Feed Configuration
# Comma-separated list of token IDs to monitor
# Example: TOKEN_IDS=0x123abc,0x456def
TOKEN_IDS=

# Logging
LOG_LEVEL=info

# Trading gates (default to paper mode)
LIVE_TRADING=false
COMPLIANCE_ACCEPTED=false

# Trading credentials (optional - only required for live trading)
# CRITICAL SECURITY: Private key storage addresses Audit Finding A-001
# 
# Method 1 (Default - Least Secure): Direct environment variable
# Only use for local development. Set SECRET_SOURCE=env (default)
# PRIVATE_KEY=your_wallet_private_key_here

ADMIN_TOKEN=polymarket-test-admin
#
# Method 2 (Improved): Encrypted local storage
# Encrypt your private key and store it here. Requires ENCRYPTION_KEY passphrase.
# To encrypt: Use the encryption tool (see docs/security.md)
# SECRET_SOURCE=encrypted
# ENCRYPTION_KEY=your_strong_passphrase_here
# ENCRYPTED_PRIVATE_KEY=salt:iv:authTag:encryptedData
#
# Method 3 (Production - AWS Secrets Manager) - NOT YET IMPLEMENTED:
# NOTE: AWS Secrets Manager integration is currently stubbed and will throw
# "not implemented" errors. This is reserved for future implementation.
# SECRET_SOURCE=aws
# AWS_SECRET_NAME=polymarket-bot/private-key
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
#
# Method 4 (Production - HashiCorp Vault) - NOT YET IMPLEMENTED:
# NOTE: HashiCorp Vault integration is currently stubbed and will throw
# "not implemented" errors. This is reserved for future implementation.
# SECRET_SOURCE=vault
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=your_vault_token
# VAULT_PATH=secret/data/polymarket
#
# Method 5 (Production - Azure Key Vault) - NOT YET IMPLEMENTED:
# NOTE: Azure Key Vault integration is currently stubbed and will throw
# "not implemented" errors. This is reserved for future implementation.
# SECRET_SOURCE=azure
# AZURE_KEY_VAULT_NAME=my-keyvault
# AZURE_SECRET_NAME=polymarket-private-key
# AZURE_CLIENT_ID=your_azure_client_id
# AZURE_CLIENT_SECRET=your_azure_client_secret
# AZURE_TENANT_ID=your_azure_tenant_id
#
CHAIN_ID=137

# Server
PORT=3000

# Retry Configuration (optional)
# Addresses Audit Finding A-009
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
# Overall timeout for all retry attempts combined in milliseconds (default: 300000 = 5 minutes)
# Prevents unbounded retry duration that could hang the system
RETRY_TOTAL_TIMEOUT=300000

# Paper Trading Configuration
# Base slippage percentage (applied to small orders)
PAPER_TRADING_SLIPPAGE=0.01
# Maximum slippage percentage (applied when order size equals available liquidity)
PAPER_TRADING_MAX_SLIPPAGE=0.05
PAPER_TRADING_FEE_RATE=0.002

# Partial Fill Simulation (for realistic CLOB behavior)
# Base probability of partial fill (0-1), scaled by order size relative to liquidity
# 0.0 = always full fill (default), 1.0 = always partial fill
PAPER_TRADING_PARTIAL_FILL_RATE=0.0
# When partial fills occur, fill between min and max ratio of order size
PAPER_TRADING_MIN_FILL_RATIO=0.1
PAPER_TRADING_MAX_FILL_RATIO=0.9

# Risk Management Configuration
RISK_MAX_EXPOSURE_PER_MARKET=1000
RISK_MAX_OPEN_ORDERS=50
RISK_MAX_DRAWDOWN=0.20
RISK_ERROR_RATE_THRESHOLD=0.10
RISK_ERROR_RATE_WINDOW=100

# Circuit Breaker Configuration (Audit Finding A-018)
# Number of consecutive failures before opening the circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Time in milliseconds to wait before attempting to close the circuit
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
# Number of successful requests in half-open state before closing
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ========================================
# Admin Authentication (Audit Finding A-004)
# ========================================
# Admin token for securing sensitive API endpoints
# REQUIRED for production and live trading modes
# Protects: kill switch, order management, trading status, config changes
#
# Generate a secure token:
#   openssl rand -hex 32
#
# All sensitive endpoints require this token in the Authorization header:
#   Authorization: Bearer YOUR_ADMIN_TOKEN
#   or simply: Authorization: YOUR_ADMIN_TOKEN
#
# Leave empty for development/testing ONLY (endpoints will be disabled)
ADMIN_TOKEN=

# CORS Configuration
# Comma-separated list of allowed origins for CORS (Cross-Origin Resource Sharing)
# CRITICAL: Use '*' ONLY for local development. Production MUST use specific origins.
# Examples:
#   Development: ALLOWED_ORIGINS=*
#   Single origin: ALLOWED_ORIGINS=https://app.example.com
#   Multiple origins: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ========================================
# Reconciliation Configuration (Gap RE-001)
# ========================================
# Interval in seconds for periodic reconciliation of orders, positions, and balances
# Detects and logs missing/orphan orders and balance/position drift
# Default: 300 seconds (5 minutes)
# Range: 60-3600 seconds (1 minute - 1 hour)
RECONCILIATION_INTERVAL_SECONDS=300

# ========================================
# Rate Limiting Configuration (Audit Finding A-008)
# ========================================
# Maximum number of requests per IP address per time window
# Prevents DoS attacks and API abuse
# Default: 100 requests per window
# Range: 1-10000 requests
RATE_LIMIT_MAX_REQUESTS=100

# Time window for rate limiting in milliseconds
# Default: 60000 ms (1 minute)
# Range: 1000-3600000 ms (1 second - 1 hour)
RATE_LIMIT_WINDOW_MS=60000

# Trust X-Forwarded-For and X-Real-IP headers from reverse proxies
# SECURITY WARNING: ONLY enable when behind a trusted reverse proxy (nginx, AWS ALB, etc.)
# If enabled without a trusted proxy, clients can spoof IPs to bypass rate limiting
# Default: false (do not trust proxy headers)
# Set to true ONLY when deployed behind nginx, load balancer, or similar trusted proxy
RATE_LIMIT_TRUST_PROXY=false

# ========================================
# Alerting Configuration (Gap OB-002, Issue #100)
# ========================================
# Telegram bot configuration for critical alerts (circuit breaker, kill switch, high error rates)
# 1. Create bot via @BotFather on Telegram - sends you a bot token
# 2. Start a chat with your bot
# 3. Get your chat ID by visiting: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#    (send a message to your bot first, then check the response for "chat":{"id":...})
# Both token and chat ID are required for alerting to work
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Alert thresholds
# Alert when error rate exceeds this percentage (default: 5%)
ALERT_ERROR_RATE_THRESHOLD=5
# Alert after this many circuit breaker trips (default: 1)
ALERT_CIRCUIT_BREAKER_TRIPS=1

# ========================================
# Learning System Configuration (Phase 8) - PARTIALLY IMPLEMENTED
# ========================================
# NOTE: LEARNING_SYSTEM_ENABLED, BANDIT_*, and METRICS_* variables are NOT YET
# wired into the backend config schema and are reserved for future use.
# Only the database path variables (EVENT_STORE_PATH, etc.) are currently used.

# Enable or disable the learning system (NOT YET IMPLEMENTED)
# Default: false (disabled for safety in live trading)
# LEARNING_SYSTEM_ENABLED=false

# Database paths for learning system components (CURRENTLY USED)
# These support the ML-powered strategy selection and backtesting features
# Default paths create files in ./data/ directory (created automatically)
EVENT_STORE_PATH=./data/events.db
SIGNAL_CATALOG_PATH=./data/signals.db
BACKTEST_ENGINE_PATH=./data/backtests.db
PROMOTION_WORKFLOW_PATH=./data/promotions.db

# Bandit Algorithm Configuration (NOT YET IMPLEMENTED)
# Algorithm type: epsilon-greedy, ucb1, thompson-sampling
# BANDIT_ALGORITHM=epsilon-greedy
# Exploration factor (0-1): higher values explore more, lower values exploit more
# BANDIT_EXPLORATION_FACTOR=0.1
# Minimum number of trades before a strategy is considered for allocation
# BANDIT_MIN_TRADE_COUNT=10

# ========================================
# Metrics Configuration (Gap OB-001) - NOT YET IMPLEMENTED
# ========================================
# NOTE: These variables are reserved for future metrics integration and are
# not currently read by the backend config or validated by the Zod schema.
# Enable Prometheus metrics collection
# Default: true (enabled for monitoring)
# METRICS_ENABLED=true
# Metrics endpoint path (relative to server)
# Default: /metrics
# METRICS_ENDPOINT=/metrics

# ========================================
# WebSocket Configuration - NOT YET IMPLEMENTED
# ========================================
# NOTE: These WebSocket tuning options are reserved for future use and are
# not currently read by the backend config or validated by the Zod schema.
# WebSocket reconnection logic exists in the code but uses hardcoded defaults.
# Initial delay before reconnection attempt in milliseconds
# Default: 1000 (1 second)
# WS_RECONNECT_DELAY=1000
# Maximum number of reconnection attempts before giving up
# Default: Infinity (unlimited reconnection attempts)
# Set to a finite number to limit reconnection attempts
# WS_MAX_RECONNECT_ATTEMPTS=Infinity
# Heartbeat interval for WebSocket ping/pong in milliseconds
# Default: 30000 (30 seconds)
# WS_HEARTBEAT_INTERVAL=30000
