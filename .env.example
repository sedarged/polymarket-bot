# Polymarket API Configuration
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Market Feed Configuration
# Comma-separated list of token IDs to monitor
# Example: TOKEN_IDS=0x123abc,0x456def
TOKEN_IDS=

# Logging
LOG_LEVEL=info

# Trading gates (default to paper mode)
LIVE_TRADING=false
COMPLIANCE_ACCEPTED=false

# Trading credentials (optional - only required for live trading)
# CRITICAL SECURITY: Private key storage addresses Audit Finding A-001
# 
# Method 1 (Default - Least Secure): Direct environment variable
# Only use for local development. Set SECRET_SOURCE=env (default)
# PRIVATE_KEY=your_wallet_private_key_here
#
# Method 2 (Improved): Encrypted local storage
# Encrypt your private key and store it here. Requires ENCRYPTION_KEY passphrase.
# To encrypt: Use the encryption tool (see docs/security.md)
# SECRET_SOURCE=encrypted
# ENCRYPTION_KEY=your_strong_passphrase_here
# ENCRYPTED_PRIVATE_KEY=salt:iv:authTag:encryptedData
#
# Method 3 (Production - AWS Secrets Manager):
# SECRET_SOURCE=aws
# AWS_SECRET_NAME=polymarket-bot/private-key
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
#
# Secret value formats supported:
# - Direct string: "0x<64-hex>" (or without 0x)
# - JSON: {"privateKey":"0x..."}, {"PRIVATE_KEY":"0x..."}, or {"private_key":"0x..."}
#
# Method 4 (Production - HashiCorp Vault):
# SECRET_SOURCE=vault
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=your_vault_token
# VAULT_PATH=secret/data/polymarket
#
# Method 5 (Production - Azure Key Vault):
# SECRET_SOURCE=azure
# AZURE_KEY_VAULT_NAME=my-keyvault
# AZURE_SECRET_NAME=polymarket-private-key
# AZURE_CLIENT_ID=your_azure_client_id
# AZURE_CLIENT_SECRET=your_azure_client_secret
# AZURE_TENANT_ID=your_azure_tenant_id
#
CHAIN_ID=137

# Server
PORT=3000
# Dedicated metrics port (Research §7 Day 6). When different from PORT, GET /metrics is served on this port.
# Set METRICS_PORT=3000 for single-port mode (metrics on same port as API).
METRICS_PORT=9090

# Retry Configuration (optional)
# Addresses Audit Finding A-009
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
# Overall timeout for all retry attempts combined in milliseconds (default: 300000 = 5 minutes)
# Prevents unbounded retry duration that could hang the system
RETRY_TOTAL_TIMEOUT=300000

# Paper Trading Configuration
# Base slippage percentage (applied to small orders)
PAPER_TRADING_SLIPPAGE=0.01
# Maximum slippage percentage (applied when order size equals available liquidity)
PAPER_TRADING_MAX_SLIPPAGE=0.05
PAPER_TRADING_FEE_RATE=0.002

# Partial Fill Simulation (for realistic CLOB behavior)
# Base probability of partial fill (0-1), scaled by order size relative to liquidity
# 0.0 = always full fill (default), 1.0 = always partial fill
PAPER_TRADING_PARTIAL_FILL_RATE=0.0
# When partial fills occur, fill between min and max ratio of order size
PAPER_TRADING_MIN_FILL_RATIO=0.1
PAPER_TRADING_MAX_FILL_RATIO=0.9

# Risk Management Configuration
RISK_MAX_EXPOSURE_PER_MARKET=1000
RISK_MAX_OPEN_ORDERS=50
RISK_MAX_DRAWDOWN=0.20
RISK_ERROR_RATE_THRESHOLD=0.10
RISK_ERROR_RATE_WINDOW=100
# Maximum fee rate in basis points (GAP-019)
# Default: 50 bps (0.5%) - Protects against excessive trading costs
# Example: 50 bps = 0.5%, 100 bps = 1.0%, 200 bps = 2.0%
RISK_MAX_FEE_RATE_BPS=50

# Circuit Breaker Configuration (Audit Finding A-018)
# Number of consecutive failures before opening the circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Time in milliseconds to wait before attempting to close the circuit
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
# Number of successful requests in half-open state before closing
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ========================================
# Admin Authentication (Audit Finding A-004)
# ========================================
# Admin token for securing sensitive API endpoints
# REQUIRED for production and live trading modes
# Protects: kill switch, order management, trading status, config changes
#
# Generate a secure token:
#   openssl rand -hex 32
#
# All sensitive endpoints require this token in the Authorization header:
#   Authorization: Bearer YOUR_ADMIN_TOKEN
#   or simply: Authorization: YOUR_ADMIN_TOKEN
#
# Leave empty for development/testing ONLY (endpoints will be disabled)
ADMIN_TOKEN=
#
# Zero-downtime admin token rotation (GAP-038):
# - Set ADMIN_TOKEN to the current token and ADMIN_TOKEN_NEXT to the new token.
# - Trigger reload: POST /api/config/reload (requires current admin token).
# - During rotation window, BOTH tokens are accepted.
# - After clients are updated, swap ADMIN_TOKEN to the new token and clear ADMIN_TOKEN_NEXT, then reload again.
ADMIN_TOKEN_NEXT=

# CORS Configuration
# Comma-separated list of allowed origins for CORS (Cross-Origin Resource Sharing)
# CRITICAL: Use '*' ONLY for local development. Production MUST use specific origins.
# Examples:
#   Development: ALLOWED_ORIGINS=*
#   Single origin: ALLOWED_ORIGINS=https://app.example.com
#   Multiple origins: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ========================================
# Reconciliation Configuration (Gap RE-001)
# ========================================
# Interval in seconds for periodic reconciliation of orders, positions, and balances
# Detects and logs missing/orphan orders and balance/position drift
# Default: 300 seconds (5 minutes)
# Range: 60-3600 seconds (1 minute - 1 hour)
RECONCILIATION_INTERVAL_SECONDS=300

# ========================================
# Rate Limiting Configuration (Audit Finding A-008)
# ========================================
# Maximum number of requests per IP address per time window
# Prevents DoS attacks and API abuse
# Default: 100 requests per window
# Range: 1-10000 requests
RATE_LIMIT_MAX_REQUESTS=100

# Time window for rate limiting in milliseconds
# Default: 60000 ms (1 minute)
# Range: 1000-3600000 ms (1 second - 1 hour)
RATE_LIMIT_WINDOW_MS=60000

# Trust X-Forwarded-For and X-Real-IP headers from reverse proxies
# SECURITY WARNING: ONLY enable when behind a trusted reverse proxy (nginx, AWS ALB, etc.)
# If enabled without a trusted proxy, clients can spoof IPs to bypass rate limiting
# Default: false (do not trust proxy headers)
# Set to true ONLY when deployed behind nginx, load balancer, or similar trusted proxy
RATE_LIMIT_TRUST_PROXY=false

# ========================================
# Alerting Configuration (Gap OB-002, Issue #100)
# ========================================
# Telegram bot configuration for critical alerts (circuit breaker, kill switch, high error rates)
# 1. Create bot via @BotFather on Telegram - sends you a bot token
# 2. Start a chat with your bot
# 3. Get your chat ID by visiting: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#    (send a message to your bot first, then check the response for "chat":{"id":...})
# Both token and chat ID are required for alerting to work
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Alert thresholds
# Alert when error rate exceeds this percentage (default: 5%)
ALERT_ERROR_RATE_THRESHOLD=5
# Alert after this many circuit breaker trips (default: 1)
ALERT_CIRCUIT_BREAKER_TRIPS=1

# ========================================
# Compliance (Research §9.1, §10.1) - FULLY IMPLEMENTED
# ========================================
# Minimum USDC balance (in USDC units). At startup, if balance < this and LIVE_TRADING=true, process exits.
# Set to 0 to disable. Research §9.1. ✓ IMPLEMENTED
MIN_BALANCE_USDC=0

# Ban-status check interval in milliseconds. Research §10.1: every 24h (86400000); §9.2: optionally 1h (3600000).
# Default: 86400000 (24 hours). Minimum: 3600000 (1 hour). ✓ IMPLEMENTED
BAN_STATUS_CHECK_INTERVAL_MS=86400000

# If true, exit on startup when GET /ban-status returns cert_required (proof of residence within 14 days).
# If false, only log and send Telegram alert. Research §10.1. ✓ IMPLEMENTED
BAN_STATUS_EXIT_IF_CERT_REQUIRED=false

# Optional path to config/markets.json (Research §6.1, §8, GAP-001). If set, tokenIds and per-market limits loaded from file.
# Example: config/markets.json or /abs/path/to/markets.json. Copy from config/markets.json.example.
# ✓ WIRED: Loaded at startup; falls back to TOKEN_IDS on errors
# ✓ GAP-001: Per-market maxPositionSize enforced by RiskManager (overrides global RISK_MAX_EXPOSURE_PER_MARKET)
# MARKETS_CONFIG_PATH=config/markets.json

# Optional path to config/strategy.json or config/strategies.json (Research §6.1, GAP-002)
# Supports two formats:
# 1. Single global config: config/strategy.json.example (backward compatible)
#    { "spread": 0.02, "maxPositionSize": 100, "inventorySkew": true }
# 2. Per-strategy configs: config/strategies.json.example (GAP-002)
#    [{ "strategyId": "...", "type": "...", "enabled": true, "params": {...} }, ...]
# ✓ WIRED: Loaded at startup; supports hot-reload via ConfigManager
# ✓ GAP-002: Per-strategy routing with independent configuration
# STRATEGY_CONFIG_PATH=config/strategies.json

# WebSocket max reconnect attempts before giving up (Research §9.3). Default 10.
# ✓ IMPLEMENTED: Wired to WebSocket client
WS_MAX_RECONNECT_ATTEMPTS=10

# Heartbeat URL (Research §9.7, §10.6). GET every 1 min. If bot stops, healthchecks.io alerts after 5 min.
# Example: https://hc-ping.com/your-uuid
# ✓ IMPLEMENTED: Fully functional
# HEARTBEAT_URL=

# ========================================
# Learning System Configuration (Phase 8) - PARTIALLY IMPLEMENTED
# ========================================
# NOTE: Learning system code exists and is functional. Database paths ARE used.
# LEARNING_SYSTEM_ENABLED and BANDIT_* variables are not yet wired to config schema.
# Learning system can be used programmatically but not controlled via env vars.

# Enable or disable the learning system ⚠️  NOT YET WIRED TO CONFIG
# Default: false (disabled for safety in live trading)
# When wired, this will enable/disable the learning system at startup
# LEARNING_SYSTEM_ENABLED=false

# Database paths for learning system components ✓ IMPLEMENTED
# These support the ML-powered strategy selection and backtesting features
# Default paths create files in ./data/ directory (created automatically)
EVENT_STORE_PATH=./data/events.db
SIGNAL_CATALOG_PATH=./data/signals.db
BACKTEST_ENGINE_PATH=./data/backtests.db
PROMOTION_WORKFLOW_PATH=./data/promotions.db

# ---- Production Safeguards (GAP-044) ✓ IMPLEMENTED ----
# EventStore: maximum events to retain (0 = unlimited, pruning removes oldest first)
# Protects against unbounded database growth in long-running deployments
# EVENT_STORE_MAX_EVENTS=0
#
# BacktestEngine: maximum concurrent backtests running at one time (default: 3)
# Prevents resource exhaustion from parallel backtests
# BACKTEST_MAX_CONCURRENT=3
#
# BacktestEngine: maximum date range in days for a single backtest (default: 365)
# Prevents unexpectedly large historical replays
# BACKTEST_MAX_DATE_RANGE_DAYS=365

# ========================================
# Data Pipeline / Ingestion Configuration (GAP-021) - IMPLEMENTED
# ========================================
# Buffers real-time market data from WebSocket feed and writes idempotent events to the EventStore.
#
# Enable/disable ingestion. Default: true (but only starts when TOKEN_IDS or MARKETS_CONFIG_PATH provide markets).
DATA_PIPELINE_ENABLED=true
#
# Flush interval (ms) for writing buffered orderbooks to EventStore.
# Default: 1000 (1 second). Range: 100..60000
DATA_PIPELINE_FLUSH_INTERVAL_MS=1000
#
# Top N levels stored per side for OrderBookUpdateEvent. Default: 10. Range: 1..50
DATA_PIPELINE_ORDERBOOK_LEVELS=10
#
# If false, only MarketEvent summaries are stored (no full orderbook events).
DATA_PIPELINE_STORE_ORDERBOOK_EVENTS=true
#
# Alert after N consecutive flush failures (Telegram if configured). Default: 3
DATA_PIPELINE_ALERT_AFTER_CONSECUTIVE_FAILURES=3
#
# Circuit breaker guarding EventStore writes during ingestion.
DATA_PIPELINE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
DATA_PIPELINE_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
DATA_PIPELINE_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Bandit Algorithm Configuration ⚠️  NOT YET WIRED TO CONFIG
# Algorithm type: epsilon-greedy, ucb1, thompson-sampling
# Code exists in apps/backend/src/learning/banditAllocator.ts but not configured via env
# BANDIT_ALGORITHM=epsilon-greedy
# Exploration factor (0-1): higher values explore more, lower values exploit more
# BANDIT_EXPLORATION_FACTOR=0.1
# Minimum number of trades before a strategy is considered for allocation
# BANDIT_MIN_TRADE_COUNT=10

# ========================================
# Metrics Configuration (Gap OB-001) - FULLY IMPLEMENTED
# ========================================
# NOTE: Prometheus metrics are ALWAYS ENABLED and fully functional.
# All core trading metrics (orders, positions, PnL, WebSocket, circuit breakers)
# are instrumented and collecting data. Metrics are served on /metrics endpoint.
# The METRICS_ENABLED and METRICS_ENDPOINT vars below are not needed (metrics always on).
# If you need to disable metrics for performance, these vars would need to be wired.
#
# Enable Prometheus metrics collection ⚠️  NOT NEEDED (always enabled)
# METRICS_ENABLED=true
# Metrics endpoint path (relative to server) ⚠️  NOT NEEDED (always /metrics)
# METRICS_ENDPOINT=/metrics

# ========================================
# WebSocket Configuration - PARTIALLY IMPLEMENTED
# ========================================
# WebSocket reconnection logic is fully functional.
# WS_MAX_RECONNECT_ATTEMPTS is wired (see above in Compliance section).
# WS_RECONNECT_DELAY and WS_HEARTBEAT_INTERVAL use hardcoded defaults.
# To make these configurable, they need to be added to config schema and
# passed to WebSocket client constructor.
#
# Initial delay before reconnection attempt in milliseconds ⚠️  NOT YET WIRED
# Default: 1000 (1 second) - currently hardcoded in websocket.ts
# WS_RECONNECT_DELAY=1000
#
# Heartbeat interval for WebSocket ping/pong in milliseconds ⚠️  NOT YET WIRED
# Default: 30000 (30 seconds) - currently hardcoded in websocket.ts
# WS_HEARTBEAT_INTERVAL=30000
#
# Maximum number of reconnection attempts ✓ IMPLEMENTED (see WS_MAX_RECONNECT_ATTEMPTS above)

# ========================================
# Exchange Rate Configuration (GAP-007)
# ========================================
# Exchange rate API URL (default: CoinGecko free tier API)
# CoinGecko is used by default as it provides free exchange rates without authentication.
# The API supports major cryptocurrencies (BTC, ETH, USDC, USDT, DAI, MATIC/POL) against fiat (USD, EUR, GBP, etc.)
EXCHANGE_RATE_API_URL=https://api.coingecko.com/api/v3

# Exchange rate cache TTL in milliseconds (default: 300000 = 5 minutes)
# Valid range: 60000-3600000 ms (1 minute - 1 hour)
# Caching reduces API calls and improves performance.
# Shorter TTL = more up-to-date rates but more API calls
# Longer TTL = fewer API calls but potentially stale rates
EXCHANGE_RATE_CACHE_TTL_MS=300000

# ========================================
# Database Backup Configuration (Gap PA-006, Issue #406)
# ========================================
# Automated backup for SQLite databases with offsite storage and rotation
# Storage backend: local, s3, gcs, azure
BACKUP_STORAGE_TYPE=local

# Local filesystem backup path (required for local storage, used as temp dir for cloud uploads)
BACKUP_LOCAL_PATH=./data/backups

# Enable compression for backups (default: true)
# Compressed backups use .db.gz extension, uncompressed use .db
BACKUP_COMPRESS=true

# Retention policy
# Maximum number of backups to keep (default: 30)
BACKUP_MAX_BACKUPS=30
# Maximum age of backups in days (default: 90)
BACKUP_MAX_AGE_DAYS=90

# AWS S3 Configuration (required when BACKUP_STORAGE_TYPE=s3)
# BACKUP_S3_BUCKET=my-backup-bucket
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=polymarket-backups/
# BACKUP_S3_ACCESS_KEY_ID=your_access_key_id
# BACKUP_S3_SECRET_ACCESS_KEY=your_secret_access_key
# Note: If access keys not provided, uses AWS SDK default credentials (IAM role, env vars, etc.)

# Google Cloud Storage Configuration (required when BACKUP_STORAGE_TYPE=gcs)
# BACKUP_GCS_BUCKET=my-backup-bucket
# BACKUP_GCS_PROJECT_ID=my-project-id
# BACKUP_GCS_PREFIX=polymarket-backups/
# BACKUP_GCS_KEY_FILENAME=/path/to/service-account-key.json
# Note: If key filename not provided, uses Application Default Credentials

# Azure Blob Storage Configuration (required when BACKUP_STORAGE_TYPE=azure)
# BACKUP_AZURE_CONTAINER=backups
# BACKUP_AZURE_PREFIX=polymarket-backups/
# Either use connection string:
# BACKUP_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# Or use account name and key:
# BACKUP_AZURE_ACCOUNT_NAME=mystorageaccount
# BACKUP_AZURE_ACCOUNT_KEY=your_account_key

# Backup schedule (cron expression for automated backups)
# Default: 0 2 * * * (daily at 2 AM)
# Format: minute hour day month weekday
# Examples:
#   0 2 * * * = daily at 2 AM
#   0 */6 * * * = every 6 hours
#   0 0 * * 0 = weekly on Sunday at midnight
BACKUP_SCHEDULE=0 2 * * *
